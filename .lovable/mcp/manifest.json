{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://edqjniadcvcoupprnnct.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "colladome-pulse-mcp",
      "version": "0.1.0",
      "title": "Colladome Pulse"
    },
    "tools": [
      {
        "name": "list_projects",
        "title": "List projects",
        "description": "List active projects visible to the signed-in Colladome employee. Optionally filter by a code or name substring.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Optional substring to match against project code or name."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_tasks",
        "title": "List my tasks",
        "description": "List the signed-in user's assigned tasks (top 50, newest first). Optionally filter by status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "review",
                "done"
              ]
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_my_attendance",
        "title": "Get my attendance for a date",
        "description": "Return the signed-in user's attendance_log row for a given date (YYYY-MM-DD) — punch in/out, total hours, tasks logged.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "Date in YYYY-MM-DD format."
            }
          },
          "required": [
            "date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_punch_status",
        "title": "Get current punch status",
        "description": "Check whether the signed-in user has an open punch session right now.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_leave_balance",
        "title": "Get my leave balances",
        "description": "Return the signed-in user's leave balances (allocated and used) per leave type.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "request_leave",
        "title": "Request leave",
        "description": "File a leave request for the signed-in user. Creates a pending leave_request row; a manager must still approve it.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "leave_type": {
              "type": "string",
              "enum": [
                "casual",
                "sick",
                "earned",
                "unpaid"
              ]
            },
            "start_date": {
              "type": "string",
              "description": "Start date in YYYY-MM-DD."
            },
            "end_date": {
              "type": "string",
              "description": "End date in YYYY-MM-DD."
            },
            "days": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 90,
              "description": "Number of leave days (0.5 for a half day)."
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "leave_type",
            "start_date",
            "end_date",
            "days"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Create task",
        "description": "Create a new task in a given project. By default the task is assigned to the signed-in user. Look up projects with list_projects first to get the project id.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid",
              "description": "Project UUID from list_projects."
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "due_date": {
              "type": "string",
              "description": "YYYY-MM-DD"
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "assignee_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID of assignee; defaults to the caller."
            }
          },
          "required": [
            "project_id",
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
